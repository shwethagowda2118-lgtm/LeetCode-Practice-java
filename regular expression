class Solution {
    public boolean isMatch(String s, String p) {
        int m = s.length();
        int n = p.length();

        // dp[i][j] represents whether s.substring(0, i) matches p.substring(0, j)
        boolean[][] dp = new boolean[m + 1][n + 1];
        dp[0][0] = true;

        // Handle patterns like a*, a*b*, .* matching an empty string s
        for (int j = 2; j <= n; j++) {
            if (p.charAt(j - 1) == '*') {
                dp[0][j] = dp[0][j - 2];
            }
        }

        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                char pChar = p.charAt(j - 1);
                char sChar = s.charAt(i - 1);

                if (pChar == '*') {
                    // 1. Zero occurrences of the preceding element
                    boolean zeroOcc = dp[i][j - 2];

                    // 2. One or more occurrences (if preceding element matches s[i - 1])
                    char prevP = p.charAt(j - 2);
                    boolean oneOrMore = (prevP == sChar || prevP == '.') && dp[i - 1][j];

                    dp[i][j] = zeroOcc || oneOrMore;
                } else if (pChar == sChar || pChar == '.') {
                    dp[i][j] = dp[i - 1][j - 1];
                }
            }
        }

        return dp[m][n];
    }
}
